# Agent Story Video Generator
# Agnes Image 2.5 Flash / Edge TTS
# 只在本机环境配置，禁止提交真实密钥
AGNES_API_KEY=
AGNES_IMAGE_SIZE=1K
AGNES_IMAGE_RATIO=9:16
AGNES_USER_TYPE=default
STORY_FILE=./story.json
STORY_OUTPUT=./story.with-images.json
STORY_SOURCE=./story.json
STORY_IMAGE_DIR=./public/images
STORY_AUDIO_DIR=./public/audio
EDGE_TTS_VOICE=zh-CN-YunxiNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
