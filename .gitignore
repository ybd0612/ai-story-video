# 用户运行时上下文与项目记忆：不提交个人内容；结构化项目规则除外
data/*
!data/
!data/memory/
!data/memory/style-preferences.json
!data/memory/README.md

# 本地 AI 工具状态
.claude/
.neuralmemory/
.workbuddy/

# 生成任务与交付产物
jobs/
outputs/

# 草稿与中间暂存（含未公开的个人题材草稿，一律不入库）
temp/*
!temp/.gitkeep

# B 阶段兼容镜像产物（由 migrate-layout mirror 生成，不作为新 SSOT 提交）
templates/story/title-template.md
templates/story/script-template.md
data/.migration/

# Node 依赖与构建缓存
**/node_modules/
**/out/
**/dist/

# 本地密钥和配置
.env
.env.*
!.env.example
*.local

# 操作系统文件
.DS_Store
Thumbs.db

# Remotion 临时运行文件
app/create-video/public/runtime/
